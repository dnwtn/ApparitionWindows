<Window x:Class="ApparitionWM.Views.ControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ApparitionWM.Models"
        xmlns:local="clr-namespace:ApparitionWM.Views"
        Title="Apparition Window Manager"
        Width="350" Height="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">

    <Window.Resources>
    </Window.Resources>

    <!-- Main panel container -->
    <Border x:Name="RootBorder"
            CornerRadius="16"
            Margin="12"
            Opacity="0">
        <Border.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" />
        </Border.RenderTransform>
        <Border.Effect>
            <!-- A subtle neon glow behind the dark glass -->
            <DropShadowEffect BlurRadius="30" ShadowDepth="6"
                              Opacity="0.4" Color="#000000" />
        </Border.Effect>

        <!-- Glass Background -->
        <Border CornerRadius="16"
                Background="{StaticResource PanelGradient}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                ClipToBounds="True">
            
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />   <!-- Header -->
                    <RowDefinition Height="12" />     <!-- Spacer -->
                    <RowDefinition Height="Auto" />   <!-- Search -->
                    <RowDefinition Height="10" />     <!-- Spacer -->
                    <RowDefinition Height="*" />      <!-- Window list -->
                    <RowDefinition Height="16" />     <!-- Spacer -->
                    <RowDefinition Height="Auto" />   <!-- Opacity Label & Value -->
                    <RowDefinition Height="Auto" />   <!-- Opacity Slider -->
                    <RowDefinition Height="16" />     <!-- Spacer -->
                    <RowDefinition Height="Auto" />   <!-- Mode Dropdown -->
                    <RowDefinition Height="20" />     <!-- Spacer -->
                    <RowDefinition Height="Auto" />   <!-- Actions -->
                </Grid.RowDefinitions>

                <!-- ── Header ──────────────────────────────── -->
                <Grid Grid.Row="0" MouseDown="Header_MouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Small ghost icon -->
                        <Viewbox Width="20" Height="20" Margin="0,0,10,0">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{StaticResource AccentBrush}"
                                      Data="M12,2 C7.58,2 4,5.58 4,10 L4,20 C4,20.55 4.45,21 5,21 L6,21 C6.55,21 7,20.55 7,20 L7,19 L8,20 C8,20.55 8.45,21 9,21 L10,21 C10.55,21 11,20.55 11,20 L11,19 L13,19 L13,20 C13,20.55 13.45,21 14,21 L15,21 C15.55,21 16,20.55 16,20 L16,19 L17,20 C17,20.55 17.45,21 18,21 L19,21 C19.55,21 20,20.55 20,20 L20,10 C20,5.58 16.42,2 12,2 Z M9.5,12 C8.67,12 8,11.33 8,10.5 C8,9.67 8.67,9 9.5,9 C10.33,9 11,9.67 11,10.5 C11,11.33 10.33,12 9.5,12 Z M14.5,12 C13.67,12 13,11.33 13,10.5 C13,9.67 13.67,9 14.5,9 C15.33,9 16,9.67 16,10.5 C16,11.33 15.33,12 14.5,12 Z">
                                      <Path.Effect>
                                          <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="{StaticResource AccentPrimary}" Opacity="0.5"/>
                                      </Path.Effect>
                                </Path>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Apparition"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Refresh button -->
                    <Button Grid.Column="1"
                            Content="⟳" FontSize="18"
                            Width="32" Height="32"
                            Padding="0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Foreground="{StaticResource TextMutedBrush}"
                            Command="{Binding RefreshCommand}"
                            ToolTip="Refresh window list" />
                </Grid>

                <!-- ── Search Filter ───────────────────────── -->
                <Grid Grid.Row="2">
                    <TextBox x:Name="SearchBox"
                             Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                             Background="{StaticResource BgSurfaceBrush}"
                             Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1"
                             FontFamily="{StaticResource AppFont}"
                             FontSize="13"
                             Padding="10,8"
                             CaretBrush="{StaticResource AccentLightBrush}" />
                    <!-- Placeholder text -->
                    <TextBlock Text="Search windows..."
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="13"
                               Margin="12,10,0,0"
                               IsHitTestVisible="False"
                               Visibility="{Binding Text, ElementName=SearchBox, 
                                            Converter={x:Static local:EmptyToVisibleConverter.Instance}}" />
                </Grid>

                <!-- ── Window List ─────────────────────────── -->
                <ListBox Grid.Row="4"
                         ItemsSource="{Binding Windows}"
                         SelectedItem="{Binding SelectedWindow}"
                         MinHeight="110">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:ManagedWindow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Window icon -->
                                <Image Grid.Column="0"
                                       Source="{Binding IconSource}"
                                       Width="18" Height="18"
                                       Margin="0,0,10,0"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Title}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           FontSize="13" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                            VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding Mode}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                    <TextBlock FontSize="12"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               Text="{Binding Opacity, 
                                                      Converter={x:Static local:ByteToPercentConverter.Instance},
                                                      StringFormat={}{0}%}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- ── Opacity Section ─────────────────────── -->
                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Text="Opacity"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,6" />
                               
                    <TextBlock Grid.Column="1"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentLightBrush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,-4">
                        <TextBlock.Text>
                            <Binding Path="Opacity" StringFormat="{}{0}%" />
                        </TextBlock.Text>
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="{StaticResource AccentPrimary}" Opacity="0.5"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>

                <!-- Signature element: Custom thick slider -->
                <Slider Grid.Row="7" 
                        Value="{Binding Opacity}" 
                        Minimum="5" Maximum="100"
                        Margin="0,4,0,4" />

                <!-- ── Mode Section ────────────────────────── -->
                <ComboBox Grid.Row="9"
                          SelectedItem="{Binding SelectedMode}"
                          ItemsSource="{Binding Source={x:Static local:WindowModeValues.All}}" />

                <!-- ── Action Buttons ──────────────────────── -->
                <Grid Grid.Row="11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="Quick Toggle"
                            Command="{Binding QuickToggleCommand}" />
                    <Button Grid.Column="2"
                            Content="Save Preset"
                            Style="{StaticResource AccentButton}"
                            Command="{Binding SavePresetCommand}" />
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
